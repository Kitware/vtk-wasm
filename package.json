{
  "name": "@kitware/vtk-wasm",
  "type": "module",
  "version": "0.0.0",
  "description": "A WebAssembly port of the VTK library",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitware/vtk-wasm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:debug": "vite build --sourcemap -m dev",
    "build:esm": "vite build",
    "build:viewer": "vite build -c vite.config.viewer.js",
    "build:vtk": "vite build -c vite.config.standalone.js",
    "build": "npm run build:esm && npm run build:vtk && npm run build:viewer",
    "build:example:camera-guide-app-ts": "npm install --no-save --prefix examples/js/camera-guide-app-ts && npm run build --prefix examples/js/camera-guide-app-ts",
    "build:example:simple-app": "npm install --no-save --prefix examples/js/simple-app && npm run build --prefix examples/js/simple-app",
    "build:example:wave-app-ts": "npm install --no-save --prefix examples/js/wave-app-ts && npm run build --prefix examples/js/wave-app-ts",
    "build:example:text-ts": "npm install --no-save --prefix examples/js/text-ts && npm run build --prefix examples/js/text-ts",
    "build:examples": "npm run build:example:camera-guide-app-ts && npm run build:example:simple-app && npm run build:example:wave-app-ts",
    "docs:api": "typedoc",
    "docs:assets": "node -e \"const fs=require('fs');fs.mkdirSync('docs/public/js',{recursive:true});for(const f of ['vtk.umd.js','viewer.umd.js','viewer.css'])fs.copyFileSync('dist/umd/'+f,'docs/public/js/'+f)\"",
    "docs:build": "npm run build && npm run build:examples && npm run docs:api && vitepress build docs",
    "docs:dev": "npm run build && npm run docs:assets && npm run docs:api && VITE_USE_LOCAL_WASM=1 vitepress dev docs",
    "docs:clean": "rimraf docs/.vitepress/dist docs/api",
    "docs:preview": "vitepress preview docs",
    "format": "prettier .  --write",
    "lint": "eslint --fix src",
    "clean": "rimraf dist",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "js-untar": "^2.0.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "9.1.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "mermaid": "^11.15.0",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "semantic-release": "25.0.2",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "vite": "^6.2.4",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "vtk-wasm": "bin/vtk-wasm.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*",
    "types/**/*",
    "bin/**"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/esm/index.mjs"
    },
    "./style.css": "./dist/esm/vtk-wasm.css",
    "./viewer": {
      "types": "./types/viewer.d.ts",
      "default": "./dist/esm/viewer.mjs"
    },
    "./viewer-umd.js": "./dist/umd/viewer.umd.js",
    "./vtk-umd.js": "./dist/umd/vtk.umd.js",
    "./viewer.css": "./dist/umd/viewer.css",
    "./umd/*": "./dist/umd/*",
    "./esm/*": "./dist/esm/*"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": "<% return branch.name === 'main'; %>"
        }
      ]
    ]
  }
}
